// Migrated from Keyball44 (zmk-config-Keyball44/config/keyball44.keymap).
// Keyball44 = 6 columns/side + 5+3 thumbs (44 keys).
// Keyball39 = 5 columns/side + 6+3 thumbs (39 keys).
//

#define DEFAULT 0
#define NAV     1
#define FUN     2
#define NUM     3
#define BALL    4
#define SCROLL  5

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

// nice!view ディスプレイ(SPI接続)
&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <180>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <80>;
};

&mt {
    tapping-term-ms = <180>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <80>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

// === トラックボール操作時の BALL 層自動切り替え ===
// ドライバ側の automouse-layer は無効化し、ZMK 標準の入力プロセッサで制御する。
// (keyball39_right.overlay の automouse-layer = <(-1)> と対で機能する)
&zip_temp_layer {
    // 直前の打鍵から 150ms 以内はボールを動かしても BALL 層へ入らない。
    // タイピング中に手がボールに触れたときの誤爆を防ぐ。
    require-prior-idle-ms = <150>;

    // ここに挙げた位置「以外」のキーを押すと BALL 層を即座に解除する。
    // = BALL 層で実際に使うキー(右手クラスタ + 左手の修飾キー)だけを列挙。
    //   row0:  5  6  7  8         LC(W) MCLK MB4 MB5
    //   row1: 12 13 14            LCTRL LSHFT F16
    //         15 16 17 18         LEFT LCLK RCLK RIGHT
    //   row2: 25 26 27 28         MO(SCROLL) SCRL_DN SCRL_UP LCTRL
    //   row3: 33 34 35            trans(LCTRL) td7(LALT) td6(LCTRL)
    excluded-positions = <5 6 7 8 12 13 14 15 16 17 18 25 26 27 28 33 34 35>;
};

/ {
    // ボールが止まってから 500ms で BALL 層を抜ける。
    // 上の excluded-positions により通常キーを打てば即座に抜けるので、
    // クリックしやすいよう長めに取っても誤爆は増えない。
    trackball_listener {
        input-processors = <&zip_temp_layer BALL 500>;
    };

    behaviors {
        // === 左親指キー: hold=引数のmod(LCTRL) / 1タップ=無反応 / 2タップ=LC(LSHFT) ===
        // (旧 td_ball。BALL 層とは無関係のため改名)
        td_lctl_inner: td_lctl_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&kp LC(LSHFT)>;
        };
        td_lctl: td_lctl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td_lctl_inner>;
        };

        // === Vial tap-dance 再現 (逆ネスト方式 + quick-tap-ms) ===
        // 外側 hold-tap（hold判定をpress時点で確立 → ホールド+他キー即動作）
        // 内側 tap-dance（tap時に多重押下で2nd-action発動）
        // quick-tap-ms により「タップ→ホールド」も内側で正しく検出

        // --- 内側 tap-dance: tap時の単押し/連打分岐 ---
        td0_inner: td0_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp SPACE>, <&mo FUN>;
        };
        td1_inner: td1_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp SPACE>, <&kp LSHFT>;
        };
        td2_inner: td2_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LANG2>, <&kp LCTRL>;
        };
        td3_inner: td3_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LANG1>, <&kp LCTRL>;
        };
        td4_inner: td4_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&sk RA(RSHFT)>;
        };
        td5_inner: td5_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp DEL>, <&kp LCTRL>;
        };
        td6_inner: td6_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&kp LSHFT>;
        };
        td7_inner: td7_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&kp LSHFT>;
        };

        // --- 外側 hold-tap: hold-preferred+quick-tap-ms で全機能を両立 ---
        td0: td0 { // hold=MO(layer), tap=td0_inner / 呼出: &td0 NAV 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&mo>, <&td0_inner>;
        };
        td1: td1 { // hold=&kp(mod), tap=td1_inner / 呼出: &td1 LALT 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td1_inner>;
        };
        td2: td2 { // 呼出: &td2 FUN 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&mo>, <&td2_inner>;
        };
        td3: td3 { // 呼出: &td3 NUM 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&mo>, <&td3_inner>;
        };
        td4: td4 { // 呼出: &td4 RALT 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td4_inner>;
        };
        td5: td5 { // 呼出: &td5 LSHFT 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td5_inner>;
        };
        td6: td6 { // 呼出: &td6 LCTRL 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td6_inner>;
        };
        td7: td7 { // 呼出: &td7 LALT 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td7_inner>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // L0: 英字 / 親指: td0=NAV, mt=LSHFT, td3=NUM, td1=LALT
        // 左親指は内側へ寄せ c2(LGUI)/c3(LCTRL)/c4(NAV)/c5(LSHFT) に集約。
        // 外側 c0/c1 は空き(&none)。
        default_layer {
            label = "QWRT";
            bindings = <
&kp Q  &kp W   &kp E    &kp R             &kp T                            &kp Y       &kp U        &kp I      &kp O    &kp P
&kp A  &kp S   &kp D    &kp F             &kp G                            &kp H       &kp J        &kp K      &kp L    &kp SEMI
&kp Z  &kp X   &kp C    &kp V             &kp B                            &kp N       &kp M        &kp COMMA  &kp DOT  &kp FSLH
&none  &none   &kp LGUI &td_lctl LCTRL 0  &td0 NAV 0      &mt LSHFT LANG2  &td3 NUM 0  &td1 LALT 0                      &mo 5
            >;
        };

        // L1: ナビ / 音量 / コピペ
        nav_layer {
            label = "NAV";
            bindings = <
&kp Q         &kp W         &kp E      &kp R      &kp T                          &kp Y     &kp ENTER  &kp ESC    &kp TAB    &kp END
&kp C_VOL_DN  &kp C_VOL_UP  &kp LCTRL  &kp LSHFT  &kp G                          &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp HOME
&kp LC(Z)     &kp LC(X)     &kp LC(C)  &kp LC(V)  &kp ENTER                      &kp BSPC  &kp GRAVE  &kp MINUS  &kp EQUAL  &kp BSLH
&trans  &trans  &kp LGUI  &trans  &trans      &trans  &td5 LSHFT 0  &td4 RALT 0                            &mo SCROLL
            >;
        };

        // L2: F-key / マウスホイール / マウスボタン
        fun_layer {
            label = "FUN";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5                            &kp F6  &kp F7  &kp F8     &kp F9    &kp F10
&kp F11    &kp F12    &kp LCTRL  &kp LSHFT  &kp F16                           &kp H   &kp J   &kp K      &kp LBKT  &kp RBKT
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)                         &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH
&trans  &trans  &kp LGUI  &trans  &trans     &trans  &td5 LSHFT 0  &td4 RALT 0                          &trans
            >;
        };

        // L3: 数字行 / td7=&kp LALT
        num_layer {
            label = "NUM";
            bindings = <
&kp N1  &kp N2    &kp N3  &kp N4  &kp N5                              &kp N6  &kp N7  &kp N8     &kp N9    &kp N0
&kp A   &kp S     &kp D   &kp F   &kp G                               &kp H   &kp J   &kp SQT    &kp LBKT  &kp RBKT
&kp Z   &kp X     &kp C   &kp V   &kp B                               &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH
&trans  &trans  &kp LGUI  &trans  &td7 LALT 0  &kp LSHFT  &trans  &trans                                  &trans
            >;
        };

        // L4: BALL (マウスボタン / スクロール起動)
        ball_layer {
            label = "BALL";
            bindings = <
&none  &none  &none       &none      &none                       &kp LC(W)   &mkp MCLK       &mkp MB4      &mkp MB5   &none
&none  &none  &kp LCTRL  &kp LSHFT  &kp F16                      &kp LEFT    &mkp LCLK       &mkp RCLK     &kp RIGHT  &none
&none  &none  &none       &none      &none                       &mo SCROLL  &msc SCRL_DOWN  &msc SCRL_UP  &kp LCTRL  &none
&none  &none  &none  &trans      &td7 LALT 0  &td6 LCTRL 0   &none       &none                                   &none
            >;
        };

        // L5: SCROLL (BT/出力切替 / 方向スクロール)
        scroll_layer {
            label = "SCROLL";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4               &out OUT_TOG    &trans     &mkp MB4   &mkp MB5   &trans
&bt BT_CLR    &trans        &kp LCTRL  &kp LSHFT  &kp F16                          &kp LEFT  &mkp LCLK  &mkp RCLK  &kp RIGHT  &trans
&trans        &trans        &trans        &trans        &trans                     &trans    &trans     &trans     &trans     &trans
&trans        &trans        &trans        &trans        &td7 LALT 0  &td6 LCTRL 0  &trans    &trans                           &trans
            >;
        };
    };
};
